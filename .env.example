# ==============================================================================
# BreatheWise AI - Environment Variables Reference (.env.example)
# ==============================================================================
# Copy this file to .env and provide your specific credentials for local execution.
# NEVER commit raw .env files containing production secrets to version control.
# ==============================================================================

# Backend Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://breathe-wise-ai.vercel.app

# Database Connection (SQLite fallback used automatically if PostgreSQL unset)
DATABASE_URL=sqlite:///./breathewise.db
RENDER_POSTGRES_EXTERNAL_URL=
RENDER_POSTGRES_INTERNAL_URL=

# AI Model Inference (Groq Cloud LLM)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# External Atmospheric & Routing Endpoints (Public APIs)
OPENMETEO_BASE_URL=https://air-quality-api.open-meteo.com/v1/air-quality
OPENMETEO_WEATHER_URL=https://api.open-meteo.com/v1/forecast
OPENAQ_BASE_URL=https://api.openaq.org/v3
OPENAQ_API_KEY=your_optional_openaq_api_key_here
OSRM_BASE_URL=https://router.project-osrm.org

# Cache Invalidation Controls (seconds)
AIR_QUALITY_CACHE_TTL=600
ROUTE_CACHE_TTL=1800

# Frontend Next.js Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
